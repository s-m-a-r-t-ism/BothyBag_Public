<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher: back up only the user's visited bothies and personal notes -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="visited_bothies.xml" />
        <include domain="sharedpref" path="bothy_notes.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="visited_bothies.xml" />
        <include domain="sharedpref" path="bothy_notes.xml" />
    </device-transfer>
</data-extraction-rules>
